{
  "name": "beyond-eslint",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "scripts": {
    "collect:biome": "node scripts/collect-biome-data.ts",
    "collect:eslint-plugins": "node scripts/collect-eslint-plugin-data.ts",
    "collect:oxlint": "node scripts/collect-oxlint-data.ts",
    "collect:rslint": "node scripts/collect-rslint-data.ts",
    "collect:ttsc": "node scripts/collect-ttsc-data.ts",
    "test": "node --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "execa": "^10.0.1",
    "p-limit": "^7.3.1",
    "typescript": "^7.0.2"
  }
}
